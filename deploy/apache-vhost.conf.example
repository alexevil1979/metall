# Apache 2.4 — metall.1tlt.ru
# PHP 8.2 FPM → proxy:fcgi://127.0.0.1:9000
# DocumentRoot = /ssd/www/metall/public
#
# DNS:
#   A    metall.1tlt.ru → IP сервера
#
# Сначала HTTP-only, затем:
#   sudo certbot --apache -d metall.1tlt.ru

<VirtualHost *:80>
    ServerName metall.1tlt.ru
    DocumentRoot /ssd/www/metall/public

    <Directory /ssd/www/metall/public>
        AllowOverride All
        Require all granted
        DirectoryIndex index.php
        Options -Indexes +FollowSymLinks
    </Directory>

    <FilesMatch "\.php$">
        SetHandler "proxy:fcgi://127.0.0.1:9000"
    </FilesMatch>

    ErrorLog ${APACHE_LOG_DIR}/metall-error.log
    CustomLog ${APACHE_LOG_DIR}/metall-access.log combined
</VirtualHost>
